digraph G {graph [rankdir=LR,bgcolor="#f7f9fc",pad=0.3,nodesep=.5,ranksep=1]; node [shape=record,style="rounded,filled",fillcolor="#e6effa",color="#6585b4",fontname="DejaVu Sans",fontsize=11]; edge [color="#6e8db2",fontname="DejaVu Sans",fontsize=10]; User [label="{User | id: UUID\lusername: String\lemail: String\lrole: Role\lisActive: Boolean\l}"]; BookTitle [label="{BookTitle | id: UUID\lisbn: String\ltitle: String\lauthor: String\l}"]; BookCopy [label="{BookCopy | id: UUID\ltitleId: UUID\lbarcode: String\lstatus: CopyStatus\l}"]; Loan [label="{Loan | readerId: UUID\lcopyId: UUID\ldueAt: DateTime\lreturnedAt?: DateTime\l}"]; Reservation [label="{Reservation | readerId: UUID\ltitleId: UUID\lheldCopyId?: UUID\lstatus: ReservationStatus\l}"]; ReservationModule [label="{services/reservations.js (module) | allocateNextHold(tx,titleId,copyId,now)\lfulfillHeldReservation(tx,readerId,copyId,now)\l}",fillcolor="#e9f4ef"]; User->Loan [label="1 to 0..*"]; User->Reservation [label="1 to 0..*"]; BookTitle->BookCopy [label="1 to 0..*"]; BookTitle->Reservation [label="1 to 0..*"]; BookCopy->Loan [label="1 to 0..*"]; BookCopy->Reservation [label="0..1 to 0..*"]; ReservationModule->Reservation [style=dashed]; ReservationModule->BookCopy [style=dashed];}