{
  "name":"unilib-server",
  "version":"0.1.0",
  "private":true,
  "type":"module",
  "engines":{"node":">=22"},
  "scripts":{
    "start":"node server.js",
    "dev":"node --watch server.js",
    "test":"node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "db:generate":"prisma generate",
    "db:migrate":"prisma migrate deploy",
    "db:dev":"prisma migrate dev",
    "db:seed":"node prisma/seed.js",
    "db:reset":"prisma migrate reset --force", "smoke":"node scripts/smoke.js", "design:check":"node scripts/check-data-design.js"
  },
  "prisma":{"seed":"node prisma/seed.js"},
  "dependencies":{"@prisma/client":"6.19.0","bcryptjs":"^3.0.2","cors":"^2.8.5","dotenv":"^16.6.1","express":"^4.21.2","jsonwebtoken":"^9.0.2"},
  "devDependencies":{"jest":"^30.2.0","prisma":"6.19.0","supertest":"^7.1.4"}
}