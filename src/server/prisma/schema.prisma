generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Reader
  Librarian
  Administrator
}

enum CopyStatus {
  Available
  Borrowed
  Reserved
  Damaged
  Lost
}

enum ReservationStatus {
  Pending
  Ready
  Fulfilled
  Cancelled
  Expired
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  username     String        @unique @db.VarChar(80)
  email        String        @unique @db.VarChar(255)
  fullName     String        @db.VarChar(160)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  role         Role          @default(Reader)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  loans        Loan[]
  reservations Reservation[]
  @@map("users")
}

model BookTitle {
  id              String        @id @default(uuid()) @db.Uuid
  isbn            String        @unique @db.VarChar(32)
  title           String        @db.VarChar(300)
  author          String        @db.VarChar(300)
  category        String        @db.VarChar(100)
  publisher       String?       @db.VarChar(160)
  publicationYear Int           @map("publication_year") @db.SmallInt
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  copies          BookCopy[]
  reservations    Reservation[]
  @@index([title])
  @@index([category, publicationYear])
  @@map("book_titles")
}

model BookCopy {
  id               String        @id @default(uuid()) @db.Uuid
  titleId          String        @map("title_id") @db.Uuid
  barcode          String        @unique @db.VarChar(80)
  shelfLocation    String        @map("shelf_location") @db.VarChar(100)
  conditionNotes   String?       @map("condition_notes") @db.Text
  status           CopyStatus    @default(Available)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  title            BookTitle     @relation(fields: [titleId], references: [id], onDelete: Restrict)
  loans            Loan[]
  heldReservations Reservation[] @relation("HeldCopy")
  @@index([titleId, status])
  @@map("book_copies")
}

model Loan {
  id           String    @id @default(uuid()) @db.Uuid
  readerId     String    @map("reader_id") @db.Uuid
  copyId       String    @map("copy_id") @db.Uuid
  checkedOutAt DateTime  @default(now()) @map("checked_out_at") @db.Timestamptz(3)
  dueAt        DateTime  @map("due_at") @db.Timestamptz(3)
  returnedAt   DateTime? @map("returned_at") @db.Timestamptz(3)
  renewedAt    DateTime? @map("renewed_at") @db.Timestamptz(3)
  reader       User      @relation(fields: [readerId], references: [id], onDelete: Restrict)
  copy         BookCopy  @relation(fields: [copyId], references: [id], onDelete: Restrict)
  @@index([readerId, returnedAt])
  @@index([copyId, returnedAt])
  @@index([dueAt, returnedAt])
  @@map("loans")
}

model Reservation {
  id          String            @id @default(uuid()) @db.Uuid
  readerId    String            @map("reader_id") @db.Uuid
  titleId     String            @map("title_id") @db.Uuid
  heldCopyId  String?           @map("held_copy_id") @db.Uuid
  status      ReservationStatus @default(Pending)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  readyAt     DateTime?         @map("ready_at") @db.Timestamptz(3)
  expiresAt   DateTime?         @map("expires_at") @db.Timestamptz(3)
  fulfilledAt DateTime?         @map("fulfilled_at") @db.Timestamptz(3)
  cancelledAt DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  reader      User              @relation(fields: [readerId], references: [id], onDelete: Restrict)
  title       BookTitle         @relation(fields: [titleId], references: [id], onDelete: Restrict)
  heldCopy    BookCopy?         @relation("HeldCopy", fields: [heldCopyId], references: [id], onDelete: Restrict)
  @@index([titleId, createdAt])
  @@index([titleId, status, createdAt])
  @@index([readerId, status])
  @@index([status, expiresAt])
  @@map("reservations")
}